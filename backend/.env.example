# Local development only. Set real values outside source control for deployments.
DEBUG=True
SECRET_KEY=local-development-only-change-before-deployment
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

BINANCE_BASE=https://api.binance.com
TWELVEDATA_KEY=

# Cache TTLs in seconds. LocMemCache is the local default.
MARKET_CANDLES_CACHE_TTL=30
MARKET_LATEST_CACHE_TTL=5

# Anonymous request limits, keyed by client IP.
ANON_THROTTLE_RATE=600/hour
MARKET_THROTTLE_RATE=120/minute
NOTES_THROTTLE_RATE=120/minute

# Optional database/cache backend settings. Install the corresponding Django
# backend driver/package before selecting a non-default backend.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
# CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
# CACHE_LOCATION=tradingview-mini-cache

# For HTTPS terminated by a trusted reverse proxy only. The proxy must overwrite
# the incoming X-Forwarded-Proto header before forwarding to Django.
# TRUST_X_FORWARDED_PROTO=True
